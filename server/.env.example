# Copy to .env and fill in real values

# Port 5000 is taken by Control Center (AirPlay Receiver) on macOS — 5001 avoids it.
PORT=5001
NODE_ENV=development

# MongoDB — local or Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/lifelink

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS / client origin
CLIENT_URL=http://localhost:5173

# Recommendation engine tuning (optional — defaults live in src/config/env.js)
RECO_MAX_DISTANCE_KM=50
RECO_DONATION_COOLDOWN_DAYS=90
